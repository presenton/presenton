# ===========================
# Development Image
# ===========================
# Use the base image with all dependencies pre-installed
# Build the base image first: docker build -f Dockerfile.base -t presenton-base .
FROM presenton-base:latest

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Expose the port
EXPOSE 80

# Start the servers in development mode
# Note: The entire project is volume-mounted from docker-compose.yml
CMD ["node", "/app/start.js", "--dev"]
