{
  "name": "presenton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --reporters=default --coverage",
    "analyze": "cross-env ANALYZE=true next build",
    "optimize:svgs": "svgo -f public/assets/svgs -o public/assets/svgs/optimized || true",
    "prepare": "husky install"
  },
  "dependencies": {
    "@babel/standalone": "^7.28.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paciolan/remote-component": "^2.13.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@reduxjs/toolkit": "^2.2.8",
    "next": "^14.2.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "uuid": "^11.1.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "svgo": "^3.0.0",
    "cross-env": "^7.0.3",
    "prettier": "^2.8.0",
    "tailwindcss": "^3.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run lint -- --fix",
      "git add"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write",
      "git add"
    ],
    "public/assets/svgs/*.svg": [
      "svgo --multipass --pretty",
      "git add"
    ]
  }
}
